PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_chat?schema=public
JWT_SECRET=replace-with-a-long-random-string
QIANFAN_ACCESS_KEY=replace-me
QIANFAN_SECRET_KEY=replace-me
QIANFAN_MODEL=ernie-4.0-8k
QIANFAN_TIMEOUT_MS=120000
CONTEXT_MAX_MESSAGES=20
CORS_ORIGIN=http://localhost:8080
# 生产默认关闭 /docs；本地开发默认开启。可强制 ENABLE_OPENAPI=true|false
# ENABLE_OPENAPI=false
# 登录/注册限流（滑动窗口，进程内）
# LOGIN_RATE_WINDOW_MS=900000
# LOGIN_RATE_MAX_PER_IDENTITY=10
# LOGIN_RATE_MAX_PER_IP=30
# 多实例必须配置；缺省则会话锁用进程内 Map（单进程 409 仍有效）
# REDIS_URL=redis://127.0.0.1:6379
