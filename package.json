{
  "name": "ai-chat",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"wait-on tcp:127.0.0.1:3000 && npm run dev:web\"",
    "dev:web": "npm run dev -w @ai-chat/web",
    "dev:api": "npm run start:dev -w @ai-chat/api",
    "build:web": "npm run build -w @ai-chat/web",
    "build:api": "npm run build -w @ai-chat/api",
    "test": "npm test -w @ai-chat/api && npm test -w @ai-chat/web",
    "lint": "npm run lint -w @ai-chat/web && npm run lint -w @ai-chat/api",
    "prisma:generate": "node apps/api/scripts/run-prisma.cjs generate",
    "prisma:migrate": "node apps/api/scripts/run-prisma.cjs migrate dev",
    "prisma:migrate:deploy": "node apps/api/scripts/run-prisma.cjs migrate deploy",
    "prisma:seed": "node apps/api/scripts/run-prisma.cjs db seed"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "deepmerge-ts": "8.0.2",
    "multer": "2.4.0",
    "qs": "6.16.0",
    "wait-on": "^8.0.5"
  },
  "overrides": {
    "deepmerge-ts": "$deepmerge-ts",
    "multer": "$multer",
    "qs": "$qs"
  },
  "engines": {
    "node": ">=20"
  }
}
