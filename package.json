{
  "name": "ai-chat",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @ai-chat/web",
    "dev:api": "npm run start:dev -w @ai-chat/api",
    "build:web": "npm run build -w @ai-chat/web",
    "build:api": "npm run build -w @ai-chat/api",
    "prisma:generate": "npm run prisma:generate -w @ai-chat/api",
    "prisma:migrate": "npm run prisma:migrate -w @ai-chat/api"
  },
  "engines": {
    "node": ">=20"
  }
}
